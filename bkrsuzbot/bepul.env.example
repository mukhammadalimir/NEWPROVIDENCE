# ===== BKRSUZBOT — bepul rejim (o'z kompyuteringizda) =====
# Bu faylni backend\.env sifatida nusxalang (ishga_tushirish.bat buni o'zi qiladi)
# va quyidagilarni to'ldiring. Haqiqiy tokenni hech qachon GitHub'ga yuklamang.

# @BotFather bergan token (majburiy)
BOT_TOKEN=
# Bot nomi, @ belgisisiz
BOT_USERNAME=Bkrsuzbot
# Mini App (GitHub Pages'da bepul, server kerak emas)
WEBAPP_URL=https://mukhammadalimir.github.io/NEWPROVIDENCE/bkrsuzbot/webapp/
# Admin(lar)ning Telegram ID raqami, vergul bilan (o'z ID'ingizni @userinfobot'dan bilasiz)
ADMIN_IDS=

# Bepul Gemini kaliti: tarjima va AI tushuntirishlar uchun.
# Olish: https://aistudio.google.com/apikey (Google akkaunt bilan, karta kerak emas)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Ovoz: bepul Microsoft Edge ovozlari (kalit kerak emas). off — o'chirish.
TTS_PROVIDER=edge

# Baza: bot yonidagi bitta fayl (bkrsuz.db). O'zgartirish shart emas.
DATABASE_URL=sqlite+aiosqlite:///bkrsuz.db

APP_ENV=prod
