# ===== Telegram =====
# Токен от @BotFather. Никогда не коммитьте настоящий токен.
BOT_TOKEN=
# Имя бота без @ (для кнопки «Поделиться» в Mini App)
BOT_USERNAME=Bkrsuzbot
# Публичный HTTPS-адрес Mini App (тот же сервер, что и API), например https://bkrsuz.example.uz/
WEBAPP_URL=
# Домен для автоматического HTTPS через Caddy (профиль https в docker-compose)
DOMAIN=
# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=
# Прокси для api.telegram.org, если он заблокирован у хостинга (http://... или socks5://...)
PROXY_URL=

# ===== База данных =====
POSTGRES_PASSWORD=change-me
# Для запуска без Docker:
# DATABASE_URL=postgresql+asyncpg://bkrsuz:change-me@localhost:5432/bkrsuz

# ===== Google Gemini: машинный перевод (бесплатный ключ, без карты) =====
# Ключ: https://aistudio.google.com/apikey . Если задан и GOOGLE_API_KEY —
# сначала Gemini, при ошибке — Cloud Translation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ===== Google Cloud: перевод и озвучка (платно, есть бесплатная квота) =====
# Один ключ API с включёнными Cloud Translation API и Cloud Text-to-Speech API
GOOGLE_API_KEY=
# Или раздельные ключи:
# GOOGLE_TRANSLATE_API_KEY=
# GOOGLE_TTS_API_KEY=
# Голоса китайского (cmn-CN). Первый — по умолчанию.
TTS_VOICES=cmn-CN-Wavenet-A,cmn-CN-Wavenet-B,cmn-CN-Wavenet-C,cmn-CN-Wavenet-D
TTS_SLOW_RATE=0.7

# ===== AI-пояснения (необязательно, платно) =====
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ===== Ограничения частоты (на пользователя) =====
RATE_SEARCH_PER_MIN=30
RATE_TTS_PER_MIN=30
RATE_AI_PER_HOUR=20

# ===== Режим =====
# prod — обязательно на сервере. dev — только локально (разрешает вход без Telegram).
APP_ENV=prod
